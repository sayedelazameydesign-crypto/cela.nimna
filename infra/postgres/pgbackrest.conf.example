# pgBackRest (MIT) — example stanza for the day nimna outgrows SQLite.
#
# TODAY: nimna's canonical store is SQLite (`scripts/backup_sqlite.py`, RPO/RTO
# in docs/RESILIENCE.md). This file is NOT wired to anything — it is the
# starting point for priority #2 (Postgres + pgBackRest) when horizontal
# writes force the migration. Copy to /etc/pgbackrest/pgbackrest.conf on the
# backup host and adapt paths.
#
#   [main]
#   pg1-path=/var/lib/postgresql/16/main
#
#   [global]
#   repo1-path=/var/lib/pgbackrest
#   repo1-retention-full=7
#   repo1-retention-diff=14
#   start-fast=y
#   process-max=4
#   log-level-console=info
#
# Minimal drill (run monthly; log the result next to the SQLite restore test):
#   pgbackrest --stanza=main backup --type=full
#   pgbackrest --stanza=main restore --delta \
#     --target-action=promote   # PITR: add --type=time --target="YYYY-MM-DD HH:MM:SS"
#   # then: start postgres, run the app's /api/health + a read query, record RTO.
#
# WAL archiving (postgresql.conf) is what makes PITR possible:
#   archive_mode=on
#   archive_command='pgbackrest --stanza=main archive-push %p'
