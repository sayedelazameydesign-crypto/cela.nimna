# ---------------------------------------------------------------------------
# Nimna – reusable-skills agent configuration
# Copy to `.env` and fill in ONE provider. Never commit the real `.env`.
# Run: chmod 600 .env  (doctor checks this)
# ---------------------------------------------------------------------------

# --- API security (nimna/api/security.py — see SECURITY.md) -----------------
# Deployment mode: production | development.  DEFAULT = production (fail-closed).
#   production : NIMNA_API_KEY is REQUIRED (>= 32 chars, [A-Za-z0-9._~+-]);
#                the server REFUSES TO BOOT without it.
#   development: key optional; WITHOUT a key only loopback clients (127.0.0.1/::1)
#                are served. Never expose a development instance publicly.
NIMNA_ENV=production

# API key(s) checked against the `X-Nimna-Key` header on every path except
# `/`, `/api/health` and `/static/*` (WebSocket: header, or the browser
# sub-protocol `nimna.key.<key>`). Comma-separate several keys to rotate
# without downtime; each key gets its own rate-limit bucket.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NIMNA_API_KEY=

# CORS allow-list: comma-separated origins (scheme://host[:port], no path, no '*').
# Unset => production: deny every cross-origin request;
#          development: http(s)://localhost | 127.0.0.1 | [::1] on any port.
# The built-in UI on `/` is same-origin and needs NO entry here.
# Example: NIMNA_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
NIMNA_ALLOWED_ORIGINS=

# Per-API-key limits (must be >= 1; cannot be disabled).
NIMNA_CHAT_RATE_LIMIT=30        # POST /api/chat requests per minute per key (429 + Retry-After)
NIMNA_WS_MAX_CONNECTIONS=10     # concurrent /ws/* connections per key

# Which model provider to use: gemini | openai | mock
MODEL_PROVIDER=gemini

# --- Gemini (free tier: https://aistudio.google.com/apikey) ------------------
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted as fallback (GEMINI wins).
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Any OpenAI-compatible endpoint (NVIDIA NIM, OpenAI, Groq, Ollama, ...) --
# NVIDIA:  https://integrate.api.nvidia.com/v1   model e.g. meta/llama-3.3-70b-instruct
# OpenAI:  https://api.openai.com/v1             model e.g. gpt-4o-mini
# Ollama:  http://localhost:11434/v1             model e.g. llama3.1  (any key)
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY is accepted as an alias for OPENAI_API_KEY (OPENAI wins).
NVIDIA_API_KEY=

# --- Agent behaviour ---------------------------------------------------------
MODEL_TEMPERATURE=0.2
AGENT_MAX_STEPS=12              # max model round-trips per request
AGENT_MAX_TOOL_CALLS=30         # max tool calls per request
AGENT_MAX_RUNTIME_SECONDS=300   # wall-clock budget
AGENT_MAX_RESPONSE_TOKENS=4096  # cap per model turn (where supported)

# --- Hard cost governance ----------------------------------------------------
# MAX_SPEND_USD=0 blocks paid/unknown model profiles before any request.
COST_GUARD_ENABLED=true
COST_GUARD_HARD=true
MAX_SPEND_USD=0
# Gemini models declared zero-cost (comma-separated). With MAX_SPEND_USD=0 any
# other GEMINI_MODEL has *unknown* pricing and the process refuses to boot
# (CostPolicyError) instead of silently blocking every request. Changing
# GEMINI_MODEL? Extend this list (your account, your free tier) or budget it below.
GEMINI_FREE_TIER_MODELS=gemini-2.5-flash
# Required only for paid/unknown OpenAI-compatible models when you explicitly budget them.
MODEL_COST_INPUT_USD_PER_1K=
MODEL_COST_OUTPUT_USD_PER_1K=
MODEL_CONTEXT_WINDOW=0
MOCK_TOOL_CALLING=false

AGENT_MAX_CONSECUTIVE_FAILURES=5
AGENT_MAX_SKILLS=3              # max skills loaded per request
AGENT_HISTORY_MESSAGES=20       # short-term memory window
AGENT_VERIFY=true               # run a verification pass on the final answer
AGENT_AUTO_APPROVE=false        # DANGEROUS: skip approvals for "confirm" tools
AGENT_DEFAULT_TOOLS=load_skill,memory_search,list_files
AGENT_MAX_USER_MESSAGE_CHARS=20000
AGENT_MAX_FILE_BYTES=5000000
AGENT_MAX_WRITE_BYTES=2000000

# --- Paths -------------------------------------------------------------------
SKILLS_DIR=skills
WORKSPACE_DIR=workspace
DB_PATH=data/nimna.db

# --- Python sandbox ----------------------------------------------------------
# subprocess = isolated interpreter + rlimits (NOT a real sandbox, always asks for
#         approval) – هذا هو الافتراضي الآمن ولا يحتاج Docker.
# docker = python:3.11-slim container, --network none, safe by default (needs Docker).
#         When running via docker-compose, use the local-sandbox profile:
#           docker compose --profile local-sandbox up nimna-sandbox
#         Do NOT mount /var/run/docker.sock in the default service – see SECURITY.md.
SANDBOX_BACKEND=subprocess
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=20
SANDBOX_MEMORY_MB=512

# --- Computer control (VNC desktop, isolated) ------------------------------
# See skills/computer_control/SKILL.md and docker-compose profile `computer`.
# The desktop is an isolated Ubuntu LXDE container with VNC/noVNC — never the host.
#   docker compose --profile computer up -d desktop
#   open http://localhost:6901  (or use Mirror View in Nimna dashboard)
COMPUTER_ENABLED=false          # set true to enable real VNC clicks/typing (default: simulated)
# VNC password for the `desktop` compose service (profile: computer). No default:
# infra/desktop/vnc-guard.sh refuses to start the desktop when it is empty, a known
# weak value (e.g. "nimna") or shorter than 12 chars. VNC only uses the first 8 chars,
# so the port is bound to 127.0.0.1.  Generate: python3 -c "import secrets;print(secrets.token_urlsafe(18))"
VNC_PASSWORD=
COMPUTER_VNC_HOST=desktop       # inside Docker network; use localhost when running Nimna outside Docker
DESKTOP_VNC_URL=http://localhost:6901
DESKTOP_API_URL=                # optional HTTP API for screenshot/click inside desktop (if you add one)

# --- Vision Gateway Cache (Sprint 1) -----------------------------------------
REDIS_URL=                      # e.g. redis://localhost:6379/0 or redis://redis:6379/0
VISION_CACHE_TTL=600

# --- Browser Use Cloud V4 (opt-in; pay-as-you-go, hard-gated) -----------------
# No request is made unless enabled, keyed, approved, and budgeted.
BROWSER_USE_ENABLED=false
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=https://api.browser-use.com
BROWSER_USE_TIMEOUT=120
BROWSER_USE_POLL_INTERVAL=2
BROWSER_USE_REASONING_EFFORT=
BROWSER_USE_MAX_SPEND_USD=0

# --- Vector Memory — Qdrant (Sprint 2) ---------------------------------------
QDRANT_URL=                     # e.g. http://localhost:6333 or http://qdrant:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
EMBEDDING_PROVIDER=auto         # auto | gemini | hash (hash = offline deterministic)

# --- Multi-Agent Swarm (Sprint 2 — Track 2) ---------------------------------
SWARM_ENABLED=false             # true = DAG + parallel sub-agents (search/code/vision)
SWARM_MAX_AGENTS=3
SWARM_PARALLEL=true             # asyncio.gather (50% latency saving)
SWARM_SELF_HEALING_RETRIES=3    # CodeAgent: execution_history vector search

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
